# ============================================================================
# VT25_2x 交易容器环境变量   cp .env.example .env  然后编辑
# ============================================================================

# ── 券商 ───────────────────────────────────────────────────────────────────
# BROKER 用来控制使用哪个券商（alpaca_paper | alpaca_live | ibkr_paper | ibkr_live）
BROKER=alpaca_paper

# ── Alpaca（https://app.alpaca.markets  Paper 账户 → API Keys）──────────────
# API Key
ALPACA_API_KEY=PKxxxxxxxx
# Secret Key
ALPACA_SECRET_KEY=xxxxxxxx

# ── IBKR（IB Gateway 集成在同一容器内）────────────────────────────────────
# 一个容器同时运行 IB Gateway（Java）和 Python Trader（通过 supervisor）
# 端口 4001 实盘 / 4002 模拟；通过 localhost 访问

# Gateway 在容器内的连接地址
IBKR_HOST=127.0.0.1
# 实盘端口（模拟用 4002）
IBKR_PORT=4001
# 客户端 ID（不要与其他程序冲突）
IBKR_CLIENT_ID=10
# 多账户时必填，例如 U1234567
IBKR_ACCOUNT=
# Interactive Brokers 用户名
IBKR_USERNAME=
# Interactive Brokers 密码
IBKR_PASSWORD=
# 2FA 设备名称（如果有多个）
IBKR_2FA_DEVICE=Mobile Authenticator app
# TOTP 密钥（可选）- 用于自动 2FA 登陆
IBKR_TOTP_SECRET=
# paper | live（影响 Gateway 启动）
IBKR_TRADING_MODE=paper

# ── 安全开关 ────────────────────────────────────────────────────────────────

# 1 = 只计算和记录订单，不下单
VT_DRY_RUN=0
# 实盘券商（*_live）必须设为 yes 才会真的下单
VT_CONFIRM_LIVE=
# 可选：本策略最多使用的资金（美元），留空 = 账户全部净值
VT_CAPITAL=

# ── 数据与执行 ──────────────────────────────────────────────────────────────

# auto(yfinance→券商行情) | yfinance | alpaca | ibkr
VT_DATA_SOURCE=auto
# close = 收盘前 MOC（默认） | open = 次日开盘前 MOO
VT_EXECUTION=close

# ── Telegram 通知（可选）─────────────────────────────────────────────────────

# Telegram Bot Token
TELEGRAM_BOT_TOKEN=
# Telegram Chat ID
TELEGRAM_CHAT_ID=
